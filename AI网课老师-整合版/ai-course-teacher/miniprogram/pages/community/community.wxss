.compose-card { padding: 20rpx; }
.compose-input {
  width: 100%;
  min-height: 120rpx;
  background: #2a2e3a;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  color: #e8eaf0;
  box-sizing: border-box;
}
.compose-placeholder { color: #7a7f8a; }
.compose-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}
.compose-count { font-size: 22rpx; color: #7a7f8a; }
.btn-post {
  background: #00e5ff;
  color: #0f1117;
  border-radius: 30rpx;
  font-weight: 600;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0 30rpx;
  margin: 0;
}
.btn-post[disabled] { opacity: 0.5; }
.post-card { padding: 24rpx; }
.post-header { display: flex; align-items: center; margin-bottom: 12rpx; }
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f1117;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.post-meta { flex: 1; }
.post-nick { font-size: 28rpx; font-weight: 600; }
.post-time { font-size: 22rpx; color: #7a7f8a; margin-top: 4rpx; }
.post-content { font-size: 28rpx; line-height: 1.7; color: #b0b6c4; }
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.like-btn { font-size: 24rpx; color: #7a7f8a; }
.like-btn.liked { color: #ff4081; }
.ai-tag {
  display: inline-block;
  background: rgba(0, 229, 255, 0.1);
  color: #00e5ff;
  border: 1rpx solid rgba(0, 229, 255, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}
.load-more {
  text-align: center;
  color: #7a7f8a;
  font-size: 26rpx;
  padding: 30rpx 0;
}
.report-btn {
  font-size: 24rpx;
  color: #ff9800;
}
