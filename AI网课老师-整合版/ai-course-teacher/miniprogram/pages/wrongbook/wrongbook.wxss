.summary { display: flex; justify-content: space-between; align-items: center; }
.summary-title { font-size: 34rpx; font-weight: 700; }
.summary-count { font-size: 24rpx; color: #00e5ff; }
.wrong-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.wrong-course { font-size: 24rpx; color: #7a7f8a; }
.wrong-count {
  font-size: 20rpx;
  color: #ff1744;
  background: rgba(255, 23, 68, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.wrong-tag {
  font-size: 20rpx;
  color: #ffd740;
  background: rgba(255, 215, 64, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}
.wrong-question { font-size: 30rpx; font-weight: 600; line-height: 1.6; margin-bottom: 16rpx; }
.wrong-actions { display: flex; gap: 16rpx; }
.action-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.action-btn:first-child {
  background: rgba(0, 229, 255, 0.1);
  color: #00e5ff;
  border: 2rpx solid #00e5ff;
}
.action-btn:last-child {
  background: rgba(255, 215, 64, 0.1);
  color: #ffd740;
  border: 2rpx solid rgba(255, 215, 64, 0.6);
}
.option {
  display: flex;
  align-items: center;
  background: #2a2e3a;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  border: 2rpx solid transparent;
}
.option-prefix { font-weight: 700; color: #00e5ff; margin-right: 12rpx; }
.option-correct { background: rgba(0, 200, 83, 0.15); border-color: #00c853; }
.option-wrong { background: rgba(255, 23, 68, 0.15); border-color: #ff1744; }
.result { margin-top: 20rpx; padding: 20rpx; background: #2a2e3a; border-radius: 12rpx; }
.result-correct { color: #00c853; font-size: 28rpx; }
.result-wrong { color: #ff1744; font-size: 28rpx; }
.result-exp { color: #b0b6c4; font-size: 26rpx; line-height: 1.6; margin-top: 8rpx; }
.empty { text-align: center; padding: 80rpx 0; }
.empty-title { font-size: 40rpx; font-weight: 700; }
.empty-sub { font-size: 26rpx; color: #7a7f8a; margin-top: 12rpx; }

.wrong-variation {
  margin-top: 16rpx;
  background: rgba(0, 229, 255, 0.1);
  color: #00e5ff;
  border: 2rpx solid #00e5ff;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.variation-block {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #1a1d27;
  border-radius: 16rpx;
  border: 2rpx solid #2a2e3a;
}

.variation-title {
  font-size: 26rpx;
  color: #00e5ff;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.variation-question {
  font-size: 28rpx;
  color: #e8eaf0;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.variation-option {
  padding: 18rpx 22rpx;
  border: 2rpx solid #2a2e3a;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #e8eaf0;
}

.variation-option.selected {
  border-color: #00e5ff;
  background: rgba(0, 229, 255, 0.08);
}

.variation-result.right {
  color: #00c853;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.variation-result.wrong {
  color: #ff1744;
  font-size: 26rpx;
  margin-top: 12rpx;
}

.variation-explanation {
  color: #b0b6c4;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
}

/* ★ 2026-09-29 修（外部审查 R09）：已作答的选项要有"不能再点"的样子。
   只加这一条 —— .wrong-option 本身没有样式规则（沿用 view 默认外观），
   这里刻意不去补全它，避免顺手改动现有视觉。
   真正拦住重复提交的是 JS 里的一次作答锁与服务端的幂等令牌，
   下面这条只是让"不能点了"这件事在界面上看得出来。 */
.wrong-option.locked {
  opacity: 0.55;
}
