.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 24rpx;
}
.avatar-large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(0, 229, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.user-info { flex: 1; }
.user-name { font-size: 36rpx; font-weight: 700; }
.user-desc { font-size: 24rpx; color: #7a7f8a; margin-top: 8rpx; }

/* 登录卡片 */
.login-card {
  text-align: center;
}

.btn-login {
  background: #00e5ff;
  color: #0f1117;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.login-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #ff8a80;
  line-height: 1.5;
}

.login-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7a7f8a;
}
.stat-card {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 20rpx;
}
.stat-item { text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #00e5ff; }
.stat-label { font-size: 22rpx; color: #7a7f8a; margin-top: 8rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid #2a2e3a;
}
.menu-item:last-child { border-bottom: none; }
.menu-icon { font-size: 34rpx; margin-right: 20rpx; }
.menu-text { flex: 1; font-size: 30rpx; }
.menu-text.danger { color: #ff1744; }
.menu-arrow { color: #7a7f8a; font-size: 32rpx; }
.version {
  text-align: center;
  color: #7a7f8a;
  font-size: 22rpx;
  padding: 40rpx 0;
}
