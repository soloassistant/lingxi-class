<view class="container">
  <!-- 用户卡片 -->
  <view class="card user-card">
    <view class="avatar-large">🎓</view>
    <view class="user-info">
      <view class="user-name">{{hasLogin ? '微信用户' : '游客'}}</view>
      <view class="user-desc">{{hasLogin ? '学习数据已云端同步' : '未登录 · 数据仅保存在本机'}}</view>
    </view>
  </view>

  <!-- 未登录：登录入口 + 失败原因 -->
  <view class="card login-card" wx:if="{{!hasLogin}}">
    <button class="btn-login" bindtap="onLogin">🔑 登录并同步数据</button>
    <view class="login-error" wx:if="{{loginError}}">⚠️ {{loginError}}</view>
    <view class="login-tip">登录后学习记录将云端保存，换设备不丢失</view>
  </view>

  <!-- 统计 -->
  <view class="card stat-card">
    <view class="stat-item">
      <view class="stat-num">{{stats.days}}</view>
      <view class="stat-label">连续学习天数</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.done}}</view>
      <view class="stat-label">完成知识点</view>
    </view>
    <view class="stat-item">
      <view class="stat-num">{{stats.wrongs}}</view>
      <view class="stat-label">待巩固错题</view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card">
    <view class="menu-item" data-url="/pages/courses/courses" bindtap="onSwitchTab">
      <text class="menu-icon">📚</text>
      <text class="menu-text">我的课程</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" data-url="/pages/plan/plan" bindtap="onSwitchTab">
      <text class="menu-icon">🎯</text>
      <text class="menu-text">学习规划</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" data-url="/pages/wrongbook/wrongbook" bindtap="onSwitchTab">
      <text class="menu-icon">📖</text>
      <text class="menu-text">错题本</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" data-url="/pages/community/community" bindtap="goCommunity">
      <text class="menu-icon">💬</text>
      <text class="menu-text">学习圈</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goReport">
      <text class="menu-icon">📊</text>
      <text class="menu-text">学习报告</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="onSubscribeWeekly">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">订阅学情周报</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="card">
    <view class="menu-item" bindtap="goSettings">
      <text class="menu-icon">⚙️</text>
      <text class="menu-text">设置</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goLegal">
      <text class="menu-icon">📄</text>
      <text class="menu-text">隐私条款</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" wx:if="{{hasLogin}}" bindtap="copyOpenid">
      <text class="menu-icon">🆔</text>
      <text class="menu-text">开发者 OpenID</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="goAdmin">
      <text class="menu-icon">🛠️</text>
      <text class="menu-text">审核后台</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="clearLocalData">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text danger">清空本地数据</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>

  <!-- 隐私合规（补丁6） -->
  <view class="card">
    <view class="menu-item" bindtap="goAgreement">
      <text class="menu-icon">📜</text>
      <text class="menu-text">用户协议与隐私政策</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="exportData">
      <text class="menu-icon">📤</text>
      <text class="menu-text">导出我的数据</text>
      <text class="menu-arrow">→</text>
    </view>
    <view class="menu-item" bindtap="deleteAccount">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text danger">注销账号</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>

  <view class="version">v1.0.0 · AI 网课老师</view>
</view>
