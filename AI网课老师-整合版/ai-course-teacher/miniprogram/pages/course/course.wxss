.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

.page.dark {
  background: #1a1a1a;
  color: #eee;
}

.course-header {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.page.dark .course-header {
  background: #2a2a2a;
}

.course-emoji {
  font-size: 80rpx;
  margin-right: 32rpx;
}

.course-name {
  font-size: 36rpx;
  font-weight: 700;
}

.course-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.course-progress-bar {
  width: 100%;
  height: 12rpx;
  background: #eee;
  border-radius: 6rpx;
  margin: 20rpx 0 8rpx;
  overflow: hidden;
}

.course-progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #4f6ef2, #7b8ff7);
}

.course-progress-text {
  font-size: 24rpx;
  color: #4f6ef2;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 0;
}

.chapter-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.page.dark .chapter-card {
  background: #2a2a2a;
}

.chapter-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.chapter-title {
  font-size: 30rpx;
  font-weight: 600;
}

.chapter-count {
  font-size: 24rpx;
  color: #999;
}

.knowledge-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid #f0f0f0;
}

.knowledge-item.done .knowledge-title {
  color: #999;
  text-decoration: line-through;
}

.knowledge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #ccc;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.knowledge-dot.done {
  background: #4f6ef2;
  border-color: #4f6ef2;
}

.knowledge-main {
  flex: 1;
}

.knowledge-title {
  font-size: 28rpx;
}

.knowledge-tags {
  margin-top: 6rpx;
}

.knowledge-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #4f6ef2;
  background: rgba(79,110,242,0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.knowledge-status {
  font-size: 28rpx;
  color: #ccc;
}

.ask-ai {
  background: #4f6ef2;
  color: #fff;
  text-align: center;
  border-radius: 40rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}
