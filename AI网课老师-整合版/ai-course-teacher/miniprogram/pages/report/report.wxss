.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #0f1117;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #7a7f8a;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #e8eaf0;
  font-weight: 600;
}

.empty-sub {
  font-size: 24rpx;
  color: #7a7f8a;
  margin-top: 12rpx;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 32rpx;
  background: #00e5ff;
  color: #0f1117;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  width: 300rpx;
}

.card {
  background: #1a1d27;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.mastery-card {
  text-align: center;
}

.mastery-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #00e5ff;
  line-height: 1;
}

.mastery-label {
  font-size: 26rpx;
  color: #b0b6c4;
  margin-top: 12rpx;
}

.mastery-bar {
  height: 12rpx;
  background: #2a2e3a;
  border-radius: 6rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.mastery-inner {
  height: 100%;
  background: #00e5ff;
}

.report-level {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.level-S\+ {
  color: #ffd740;
  background: rgba(255, 215, 64, 0.12);
}

.level-S {
  color: #00e5ff;
  background: rgba(0, 229, 255, 0.12);
}

.level-A\+ {
  color: #ff8a80;
  background: rgba(255, 138, 128, 0.12);
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* ---------- 学习热力图 ---------- */
.heat-card {
  background: #1a1d27;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.heat-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.heat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8eaf0;
}

.heat-days {
  font-size: 22rpx;
  color: #7a7f8a;
}

.heat-grid {
  display: grid;
  grid-template-columns: repeat(15, 1fr);
  gap: 8rpx;
}

.heat-cell {
  height: 30rpx;
  border-radius: 6rpx;
  background: #2a2e3a;
}

.heat-cell.on {
  background: #00e5ff;
}

.heat-cell.on.hot {
  background: #00b8d4;
  box-shadow: 0 0 8rpx rgba(0, 229, 255, 0.5);
}

.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}

.heat-leg-item {
  font-size: 20rpx;
  color: #7a7f8a;
}

.heat-legend .heat-cell {
  width: 24rpx;
  height: 24rpx;
  display: inline-block;
}


/* ---------- 学情周报 ---------- */
.weekly-card {
  background: linear-gradient(135deg, #1d2b3a 0%, #1a1d27 60%);
  border: 1rpx solid rgba(0, 229, 255, 0.18);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.weekly-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.weekly-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8eaf0;
}

.weekly-week {
  font-size: 24rpx;
  color: #00e5ff;
  background: rgba(0, 229, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.weekly-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.weekly-item {
  text-align: center;
}

.weekly-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #00e5ff;
  line-height: 1.2;
}

.weekly-label {
  font-size: 22rpx;
  color: #7a7f8a;
  margin-top: 6rpx;
}

.weekly-advice {
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #b0b6c4;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  padding: 20rpx;
}

.weekly-empty {
  font-size: 26rpx;
  color: #7a7f8a;
  padding: 20rpx 0;
}

.btn-subscribe {
  margin-top: 24rpx;
  background: #00e5ff;
  color: #0f1117;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  line-height: 2.6;
}

.btn-subscribe.done {
  background: rgba(0, 229, 255, 0.12);
  color: #00e5ff;
}

.weekly-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7a7f8a;
  text-align: center;
}

.stat-item {
  background: #1a1d27;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #e8eaf0;
}

.stat-label {
  font-size: 24rpx;
  color: #7a7f8a;
  margin-top: 8rpx;
}

/* ★ R11：正确率口径说明（样本量/为什么是"—"）。
   指标必须能自解释，否则"正确率 0%"会被当成学习结果而不是"没有数据"。 */
.stat-note {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7a7f8a;
  background: rgba(0, 229, 255, 0.06);
  border-radius: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8eaf0;
  margin: 28rpx 0 16rpx;
}

.rec-card {
  background: #1a1d27;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-title {
  font-size: 28rpx;
  color: #e8eaf0;
  flex: 1;
}

.rec-course {
  font-size: 22rpx;
  color: #7a7f8a;
  margin-right: 16rpx;
}

.rec-arrow {
  color: #00e5ff;
  font-size: 30rpx;
}

.weak-card {
  background: #1a1d27;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.weak-name {
  font-size: 26rpx;
  color: #e8eaf0;
  width: 200rpx;
  flex-shrink: 0;
}

.weak-bar {
  flex: 1;
  height: 10rpx;
  background: #2a2e3a;
  border-radius: 5rpx;
  overflow: hidden;
  margin: 0 20rpx;
}

.weak-inner {
  height: 100%;
  background: #ffd740;
}

.weak-count {
  font-size: 24rpx;
  color: #ffd740;
  flex-shrink: 0;
}

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.achievement {
  background: #1a1d27;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  text-align: center;
}

.achievement.locked {
  opacity: 0.4;
}

.achievement-icon {
  font-size: 44rpx;
}

.achievement-name {
  font-size: 22rpx;
  color: #b0b6c4;
  margin-top: 8rpx;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-quiz {
  flex: 1;
  background: #00e5ff;
  color: #0f1117;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-wrongbook {
  flex: 1;
  background: #2a2e3a;
  color: #b0b6c4;
  border-radius: 12rpx;
  font-size: 28rpx;
}
