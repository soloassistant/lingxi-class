.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

.page.dark {
  background: #1a1a1a;
  color: #eee;
}

.teach-head {
  margin-bottom: 24rpx;
}

.teach-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.teach-title {
  font-size: 36rpx;
  font-weight: 700;
}

.teach-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.no-video {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.page.dark .no-video {
  background: #2a2a2a;
}

.no-video-icon {
  font-size: 80rpx;
}

.no-video-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.body-block {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.page.dark .body-block {
  background: #2a2a2a;
}

.body-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.body-tab {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.body-tab.active {
  background: #4f6ef2;
  color: #fff;
}

.body-content {
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.quiz-block {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.page.dark .quiz-block {
  background: #2a2a2a;
}

.quiz-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.quiz-question {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.quiz-option {
  padding: 20rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.quiz-option.selected {
  border-color: #4f6ef2;
}

.quiz-option.correct {
  background: #e8f8e8;
  border-color: #4caf50;
}

.quiz-option.wrong {
  background: #fdeaea;
  border-color: #f44336;
}

.quiz-explain {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.explain-correct {
  color: #4caf50;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.explain-wrong {
  color: #f44336;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.explain-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
}

.btn-next {
  margin-top: 24rpx;
  background: #4f6ef2;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-ai {
  margin-top: 20rpx;
  background: #00bcd4;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.ai-explain {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #e6f7fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #00796b;
  line-height: 1.7;
}

.ask-bar {
  margin-top: 24rpx;
}

.btn-ask {
  background: #4f6ef2;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.ask-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.ask-dialog {
  width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.ask-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.ask-input {
  width: 100%;
  height: 120rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 对话流 */
.ask-chat {
  height: 480rpx;
  max-height: 480rpx;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.chat-row {
  display: flex;
  margin-bottom: 16rpx;
}

.chat-row.chat-user {
  justify-content: flex-end;
}

.chat-row.chat-ai {
  justify-content: flex-start;
}

.chat-bubble {
  max-width: 80%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  word-break: break-all;
}

.chat-user .chat-bubble {
  background: #4f6ef2;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.chat-ai .chat-bubble {
  background: #e6f7fb;
  color: #00796b;
  border-bottom-left-radius: 4rpx;
}

/* ★ 2026-09-29 修（外部审查 R13）：失败卡片。
   刻意做得与"老师的气泡"明显不同（描边 + 无填充 + 警示色），
   避免学生把错误提示误当成老师的回答。 */
.chat-error {
  max-width: 80%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff7f7;
  border: 1rpx solid #ffcdd2;
}
.chat-error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #c62828;
}
.chat-error-note {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9e9e9e;
}
.chat-error-btn {
  display: inline-block;
  margin-top: 14rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #4f6ef2;
  color: #fff;
  font-size: 24rpx;
}

.ask-reply {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #e6f7fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #00796b;
  line-height: 1.7;
}

.ask-reply-loading {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.ask-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.ask-cancel {
  flex: 1;
  background: #f0f0f0;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.ask-submit {
  flex: 1;
  background: #4f6ef2;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.ai-teach-entry {
  margin-bottom: 24rpx;
}

.btn-ai-teach {
  background: #4f6ef2;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.ai-teach-block {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.page.dark .ai-teach-block {
  background: #2a2a2a;
}

.ai-teach-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ai-teach-progress {
  font-size: 24rpx;
  color: #999;
}

.ai-teach-exit {
  font-size: 24rpx;
  color: #4f6ef2;
}

.ai-teach-nav-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.ai-teach-speak {
  font-size: 24rpx;
  color: #00bcd4;
}

.body-speak {
  display: inline-block;
  font-size: 24rpx;
  color: #00bcd4;
  margin-bottom: 16rpx;
}

.ai-teach-text {
  font-size: 30rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  color: #333;
}

.page.dark .ai-teach-text {
  color: #eee;
}

.ai-board {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f0f6ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #4f6ef2;
}

.page.dark .ai-board {
  background: #1a2a3a;
}

.board-title {
  font-size: 24rpx;
  color: #4f6ef2;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.board-step {
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 8rpx;
  color: #333;
}

.page.dark .board-step {
  color: #ccc;
}

.board-svg {
  margin-top: 16rpx;
}

.board-svg-canvas {
  width: 100%;
  height: auto;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 8rpx;
  display: block;
}

.page.dark .board-svg-canvas {
  background: rgba(0, 0, 0, 0.2);
}

.ai-teach-summary {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #f0fbf0;
  border-radius: 12rpx;
  border-left: 6rpx solid #4caf50;
}

.page.dark .ai-teach-summary {
  background: #1a2a1a;
}

.summary-title {
  font-size: 24rpx;
  color: #4caf50;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #333;
}

.page.dark .summary-text {
  color: #ccc;
}

.ai-teach-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-ai-prev {
  flex: 1;
  background: #f0f0f0;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-ai-next {
  flex: 1;
  background: #4f6ef2;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* ── 费曼学习法（2026-10-01）──────────────────────────────
   ① 课堂内的教学法开关；② 讲完后的"轮到你讲"任务卡；③ 课后「讲给我听」环节。 */
.feyn-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.feyn-text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.feyn-name { font-size: 30rpx; font-weight: 600; }
.feyn-desc { font-size: 24rpx; color: #999; line-height: 1.5; }
.switch {
  width: 88rpx; height: 50rpx; border-radius: 25rpx; background: #d8d8de;
  position: relative; flex-shrink: 0; transition: background .2s;
}
.switch.on { background: #5b5ce6; }
.switch-dot {
  position: absolute; top: 5rpx; left: 5rpx; width: 40rpx; height: 40rpx;
  border-radius: 50%; background: #fff; transition: transform .2s;
}
.switch.on .switch-dot { transform: translateX(38rpx); }

.feyn-check {
  background: #f3f2fe;
  border: 2rpx solid #ddd6fe;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}
.feyn-check-title { font-size: 30rpx; font-weight: 700; color: #5b21b6; margin-bottom: 12rpx; }
.feyn-check-text { font-size: 28rpx; line-height: 1.65; color: #333; margin-bottom: 20rpx; }
.btn-feyn-talk {
  background: #5b5ce6; color: #fff; font-size: 28rpx;
  border-radius: 12rpx; line-height: 2.4; padding: 0 32rpx;
}

.feyn-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  display: flex; align-items: flex-end; z-index: 50;
}
.feyn-dialog {
  width: 100%; max-height: 88vh; background: #fff;
  border-radius: 24rpx 24rpx 0 0; padding: 32rpx 28rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column;
}
.feyn-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.feyn-title { font-size: 34rpx; font-weight: 700; }
.feyn-close { font-size: 28rpx; color: #999; padding: 8rpx 12rpx; }
.feyn-intro {
  font-size: 25rpx; color: #666; line-height: 1.6;
  background: #f3f2fe; border-radius: 12rpx; padding: 18rpx 20rpx; margin-bottom: 16rpx;
}
.feyn-em { color: #4647d8; font-weight: 600; }

.feyn-log {
  flex: 1; min-height: 300rpx; max-height: 46vh;
  border: 2rpx solid #eee; border-radius: 16rpx;
  background: #fcfcfe; padding: 12rpx; margin-bottom: 16rpx; box-sizing: border-box;
}
.feyn-msg { margin-bottom: 16rpx; }
.feyn-me { display: flex; flex-direction: column; align-items: flex-end; }
.feyn-who { font-size: 22rpx; color: #999; margin-bottom: 6rpx; }
.feyn-bubble {
  font-size: 28rpx; line-height: 1.6; padding: 18rpx 22rpx;
  border-radius: 14rpx; background: #f1f0fe; color: #222;
  max-width: 86%; word-break: break-word;
}
.feyn-me .feyn-bubble { background: #5b5ce6; color: #fff; }
.feyn-typing { color: #999; font-style: italic; }
.feyn-err { background: #fff1f0; color: #a8071a; }
.feyn-err-note { display: block; font-size: 22rpx; color: #999; margin-top: 8rpx; }
.feyn-retry {
  display: inline-block; margin-top: 12rpx; font-size: 24rpx;
  color: #5b5ce6; border: 2rpx solid #5b5ce6; border-radius: 8rpx; padding: 4rpx 18rpx;
}

.feyn-verdict {
  background: #f3f2fe; border: 2rpx solid #ddd6fe;
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx;
}
.feyn-v-title { font-size: 30rpx; font-weight: 700; color: #5b21b6; margin-bottom: 14rpx; }
.feyn-v-block { margin-bottom: 16rpx; }
.feyn-v-label { font-size: 27rpx; font-weight: 600; margin-bottom: 8rpx; }
.feyn-v-item { font-size: 27rpx; line-height: 1.6; color: #333; }
.feyn-v-empty { font-size: 25rpx; color: #999; }
.feyn-v-hint { font-size: 26rpx; color: #666; line-height: 1.65; }
.feyn-v-comment {
  font-size: 27rpx; line-height: 1.65; color: #333;
  background: #fff; border-radius: 12rpx; padding: 18rpx 20rpx;
}

.feyn-input {
  width: 100%; box-sizing: border-box; min-height: 150rpx;
  font-size: 28rpx; line-height: 1.6; padding: 20rpx;
  border: 2rpx solid #eee; border-radius: 14rpx; background: #fff; margin-bottom: 16rpx;
}
.feyn-btns { display: flex; gap: 20rpx; }
.feyn-send, .feyn-finish { flex: 1; font-size: 28rpx; border-radius: 12rpx; line-height: 2.6; }
.feyn-send { background: #5b5ce6; color: #fff; }
.feyn-finish { background: #eee; color: #333; }
.feyn-send[disabled], .feyn-finish[disabled] { opacity: .5; }

/* 深色模式 */
.page.dark .feyn-row,
.page.dark .feyn-dialog { background: #252525; color: #eee; }
.page.dark .feyn-desc,
.page.dark .feyn-who { color: #999; }
.page.dark .feyn-check,
.page.dark .feyn-verdict { background: #2c2a3d; border-color: #4b4569; }
.page.dark .feyn-check-text,
.page.dark .feyn-v-item,
.page.dark .feyn-v-comment { color: #ddd; }
.page.dark .feyn-bubble { background: #333; color: #eee; }
.page.dark .feyn-me .feyn-bubble { background: #5b5ce6; color: #fff; }
.page.dark .feyn-log { background: #1e1e1e; border-color: #333; }
.page.dark .feyn-intro { background: #2c2a3d; color: #bbb; }
.page.dark .feyn-input { background: #1e1e1e; border-color: #333; color: #eee; }
.page.dark .feyn-finish { background: #333; color: #ddd; }
.page.dark .switch { background: #444; }
.page.dark .switch.on { background: #5b5ce6; }
