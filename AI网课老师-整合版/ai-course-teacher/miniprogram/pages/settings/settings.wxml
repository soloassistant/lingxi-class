<view class="container">
  <view class="card">
    <view class="sec-title">外观</view>
    <view class="row">
      <text class="row-label">暗黑模式</text>
      <switch checked="{{theme === 'dark'}}" bindchange="onThemeChange" color="#00e5ff" />
    </view>
    <view class="row col">
      <text class="row-label">正文字号</text>
      <radio-group class="font-group" bindchange="onFontChange">
        <label class="font-opt {{fontSize === item.key ? 'active' : ''}}" wx:for="{{fontOptions}}" wx:key="key">
          <radio value="{{item.key}}" checked="{{fontSize === item.key}}" color="#00e5ff" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">数据</view>
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🧹</text>
      <text class="menu-text">清空缓存</text>
      <text class="menu-desc">保留登录态</text>
      <text class="menu-arrow">→</text>
    </view>
  </view>

  <view class="tip">主题与字号设置会自动同步到所有页面</view>
</view>
