.admin-header {
  margin-bottom: 20rpx;
}
.admin-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eaf0;
}
.admin-tip {
  font-size: 22rpx;
  color: #7a7f8a;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #7a7f8a;
  background: #1a1d27;
  border-radius: 12rpx;
}
.tab.active {
  color: #00e5ff;
  background: rgba(0, 229, 255, 0.12);
  font-weight: 600;
}

.notice {
  font-size: 24rpx;
  color: #7a7f8a;
  padding: 16rpx;
  text-align: center;
}
.loading {
  text-align: center;
  color: #7a7f8a;
  font-size: 26rpx;
  padding: 32rpx;
}

.draft-card {
  padding: 24rpx;
}
.draft-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.draft-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8eaf0;
}
.draft-type {
  font-size: 20rpx;
  color: #00e5ff;
  border: 1rpx solid rgba(0, 229, 255, 0.4);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.draft-meta {
  font-size: 22rpx;
  color: #7a7f8a;
  margin-top: 8rpx;
}

.draft-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.btn-reject {
  flex: 1;
  background: #2a2e3a;
  color: #b0b6c4;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.btn-approve {
  flex: 1;
  background: #00e5ff;
  color: #0f1117;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.draft-status {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7a7f8a;
}

.empty {
  text-align: center;
  color: #7a7f8a;
  font-size: 26rpx;
  padding: 64rpx 0;
}
