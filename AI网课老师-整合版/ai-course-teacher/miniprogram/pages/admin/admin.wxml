<view class="container">
  <view class="admin-header">
    <text class="admin-title">AI 生成内容审核</text>
    <text class="admin-tip">审核通过后课程将发布上线</text>
  </view>

  <view class="tabs">
    <view class="tab {{status === 'draft' ? 'active' : ''}}" data-status="draft" bindtap="switchStatus">待审核</view>
    <view class="tab {{status === 'approved' ? 'active' : ''}}" data-status="approved" bindtap="switchStatus">已通过</view>
    <view class="tab {{status === 'rejected' ? 'active' : ''}}" data-status="rejected" bindtap="switchStatus">已驳回</view>
  </view>

  <view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <block wx:for="{{drafts}}" wx:key="id">
    <view class="card draft-card">
      <view class="draft-top">
        <text class="draft-title">{{item.title || item.topic || '未命名'}}</text>
        <text class="draft-type">{{item.type === 'teach' ? '授课' : '课程'}}</text>
      </view>
      <view class="draft-meta">{{item.system}} · {{item.subject}} · {{item.topic}}</view>

      <view class="draft-actions" wx:if="{{status === 'draft'}}">
        <button class="btn-reject" data-id="{{item.id}}" data-action="reject" bindtap="review">驳回</button>
        <button class="btn-approve" data-id="{{item.id}}" data-action="approve" bindtap="review">通过并发布</button>
      </view>
      <view class="draft-status" wx:else>
        <text>{{status === 'approved' ? '已通过' : '已驳回'}}</text>
      </view>
    </view>
  </block>

  <view class="empty" wx:if="{{!loading && drafts.length === 0}}">暂无{{status === 'draft' ? '待审核' : (status === 'approved' ? '已通过' : '已驳回')}}的内容</view>
</view>
