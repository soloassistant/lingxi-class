.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}
.empty-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; color: #e8eaf0; font-weight: 600; }
.empty-desc {
  font-size: 26rpx;
  color: #7a7f8a;
  text-align: center;
  line-height: 1.6;
  margin: 12rpx 0 32rpx;
}
.empty-btn {
  background: #00e5ff;
  color: #0f1117;
  border-radius: 40rpx;
  font-weight: 600;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0 48rpx;
  margin: 0;
}
