<view class="modal-mask" wx:if="{{visible || show}}" catchtouchmove="noop">
  <view class="modal">
    <view class="modal-title">用户隐私保护指引</view>
    <view class="modal-sub">我们非常重视你的隐私安全，请阅读并同意以下内容后继续</view>
    <scroll-view class="modal-body" scroll-y="true">
      <view class="section-title">为提供服务，我们会申请以下权限</view>
      <view class="data-item" wx:for="{{permissions}}" wx:key="*this">• {{item}}</view>
      <view class="section-title">我们收集的数据</view>
      <view class="data-item" wx:for="{{collectedData}}" wx:key="*this">• {{item}}</view>
      <view class="section-title">我们不会收集</view>
      <view class="data-item no" wx:for="{{notCollected}}" wx:key="*this">• {{item}}</view>
      <view class="agreement-row">
        <text bindtap="goPrivacy">《隐私政策》</text>
        <text>与</text>
        <text bindtap="goAgreement">《用户协议》</text>
      </view>
    </scroll-view>
    <view class="modal-footer">
      <button class="btn-agree" bindtap="onAgree">同意并继续</button>
      <button class="btn-disagree" bindtap="onDisagree">不同意</button>
    </view>
  </view>
</view>
