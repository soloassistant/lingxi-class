page {
  background: #0f1117;
  color: #e8eaf0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}
.container {
  padding: 24rpx;
}
.card {
  background: #1a1d27;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.btn-primary {
  background: #00e5ff;
  color: #0f1117;
  border-radius: 44rpx;
  font-weight: 600;
}
.ai-tag {
  display: inline-block;
  background: rgba(0, 229, 255, 0.1);
  color: #00e5ff;
  border: 1rpx solid rgba(0, 229, 255, 0.4);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
}
