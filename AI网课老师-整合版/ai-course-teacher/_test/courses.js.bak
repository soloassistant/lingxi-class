// 课程体系（考试局/体系分组），供课程列表页按体系展示
const systems = [
  { id: 'ielts', name: '雅思 IELTS', board: '英国文化协会 / IDP' },
  { id: 'toefl', name: '托福 TOEFL', board: 'ETS' },
  { id: 'sat', name: 'SAT', board: 'College Board' },
  { id: 'igcse', name: 'IGCSE', board: 'Cambridge' },
  { id: 'alevel', name: 'A-Level', board: 'CAIE / Edexcel / AQA' },
  { id: 'ap', name: 'AP', board: 'College Board' },
  { id: 'ib', name: 'IB', board: 'IBO' }
];

// 依据课程 id 前缀补全 systemId，供按体系过滤
const systemPrefixes = ['ielts', 'toefl', 'sat', 'igcse', 'alevel', 'ap', 'ib'];
courses.forEach(c => {
  const prefix = systemPrefixes.find(p => c.id.startsWith(p));
  c.systemId = prefix || 'other';
});

module.exports = { courses, chapters, knowledge, systems };
